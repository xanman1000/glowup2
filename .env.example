# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=glowup-ai-images

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/glowup_ai

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Amazon Affiliate Configuration
AMAZON_ACCESS_KEY_ID=your_amazon_affiliate_access_key
AMAZON_SECRET_ACCESS_KEY=your_amazon_affiliate_secret_key
AMAZON_ASSOCIATE_TAG=your_amazon_associate_tag

# App Configuration
APP_ENV=development
API_BASE_URL=http://localhost:8000
JWT_SECRET=your_jwt_secret_key

# Analytics
POSTHOG_API_KEY=your_posthog_api_key

# Image Processing
MAX_IMAGE_SIZE=5MB
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,webp

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600